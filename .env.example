# Copy this file to .env and fill in real values. .env is git-ignored.

# From https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Which OpenAI model to use. A small, cheap one is fine to start.
OPENAI_MODEL=gpt-4o-mini


# Qdrant Cloud (production only). Leave empty locally to use the qdrant_data/ folder.
# QDRANT_URL=https://xxxx.cloud.qdrant.io
# QDRANT_API_KEY=...

# SEC EDGAR request header, "Name email". Only needed to run scripts/build_key_figures.py.
# SEC_USER_AGENT=Your Name you@example.com